# Kinderfestival Turnierplaner - Development Dockerfile
# Basierend auf Node.js mit Hot Reload
# Verwaltet Vite + Svelte 5 (kein SvelteKit)

FROM node:20-alpine AS development

# Set working directory
WORKDIR /app

# Install git (for npm packages that need it)
RUN apk add --no-cache git

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies)
RUN npm ci

# Copy source files (excluding node_modules to avoid conflicts with volume mount)
COPY . .

# Expose development port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=5 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:5173 || exit 1

# Start development server with hot reload
# Using vite dev with host 0.0.0.0 to allow external connections
CMD ["npm", "run", "dev"]
